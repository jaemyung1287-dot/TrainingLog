rules_version = '2';

// Skeleton Team Bayern — Firestore 보안 규칙
//
// 목적: 기록이 사라지는 경로를 없앤다.
//
// 2026-08-08 이전에는 규칙 파일이 아예 없어서 데이터베이스가 완전히 열려 있었다.
// API 키는 비밀이 아니라 주소에 가깝고(클라이언트 소스에 그대로 박혀 공개된다),
// 실제 자물쇠 역할은 이 파일이 한다. 규칙이 없으면 주소를 아는 누구나 전부 지울 수 있다.
//
// 핵심 원칙: **delete는 어디서도 허용하지 않는다.**
// 앱의 로그 삭제는 문서를 지우는 대신 `_deleted: true` 표시만 남기도록 바뀌었고
// (TrainLog.html의 묘비 처리 · dashboard.html의 delLog), 읽는 쪽에서 걸러낸다.
// 따라서 정상 동작에는 delete가 전혀 필요 없다.
//
// 인증은 아직 쓰지 않는다(앱 3종이 모두 익명 접근). 그래서 이 규칙은
// "아무나 읽고 쓸 수 있지만, 아무도 지울 수는 없다"까지만 보장한다.
// 인증 도입은 시즌 준비가 끝난 뒤 별도로 진행한다.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Bayern TrainLog (선수 앱 · 코치 대시보드 2종) ───────────────
    // trainlog/{문서} · trainlog/athlete_*/logs/{로그} · trainlog/coach/plans/{날짜}
    match /trainlog/{doc=**} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ── Road to 2030 (별도 앱, 같은 프로젝트를 공유) ────────────────
    match /road2030/{doc=**} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ── 옛 내부 백업 (읽기 전용, 폐기됨) ──────────────────────────
    // trainlog_backups 에는 2026-08-02~08 스냅샷 7건이 남아 있다.
    //
    // 정정(2026-09-22): "Cloud Function 이 제거돼서 갱신이 없다"고 적어뒀던 건
    // 사실이 아니었다. 실제로는 Claude 스케줄 작업이 매일 여기에 쓰고 있었고,
    // 2026-08-08 에 이 규칙(write:false)이 배포되면서 그날로 막힌 것이다.
    // 45일간 아무도 몰랐다 — 작업은 매일 "성공"으로 끝났기 때문.
    //
    // 이 백업은 백업 대상과 같은 프로젝트 안에 있어 방어력이 가장 약했고,
    // GitHub Actions 스냅샷(오프사이트)이 같은 일을 더 잘 하고 있어
    // 2026-09-22 에 스케줄 작업째 폐기했다. 대신 백업이 멈추면 알아채도록
    // trainlog/backup_heartbeat 신호 + 감시 작업을 두었다.
    // 남은 7건은 꺼내볼 수 있어야 하므로 읽기만 허용한다.
    match /trainlog_backups/{doc=**} {
      allow read: if true;
      allow write: if false;
    }

    // ── 그 외 전부 차단 ────────────────────────────────────────────
    // 새 컬렉션을 임의로 만들 수 없게 한다. 앱이 새 컬렉션을 쓰게 되면
    // 위에 match 블록을 명시적으로 추가할 것.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
