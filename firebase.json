{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": [
    {
      "target": "trainlog",
      "public": "www-trainlog",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },
    {
      "target": "road2030",
      "public": "www-road2030",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    }
  ]
}
